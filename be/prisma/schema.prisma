generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant")
}

model Staff {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  bitrixId     String?
  googleId     String?  @unique
  microsoftId  String?  @unique
  active       Boolean  @default(true)
  tenantId     String   @default("ventas")
  roleId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role                 Role?          @relation(fields: [roleId], references: [id])
  createdSteps         Step[]         @relation("StepCreatedBy")
  updatedSteps         Step[]         @relation("StepUpdatedBy")
  createdHets          Het[]          @relation("HetCreatedBy")
  updatedHets          Het[]          @relation("HetUpdatedBy")
  createdPhases        Phase[]        @relation("PhaseCreatedBy")
  updatedPhases        Phase[]        @relation("PhaseUpdatedBy")
  createdWorkOrders    WorkOrder[]    @relation("WorkOrderCreatedBy")
  updatedWorkOrders    WorkOrder[]    @relation("WorkOrderUpdatedBy")
  createdBoms          Bom[]          @relation("BomCreatedBy")
  updatedBoms          Bom[]          @relation("BomUpdatedBy")
  createdBomLines      BomLine[]      @relation("BomLineCreatedBy")
  updatedBomLines      BomLine[]      @relation("BomLineUpdatedBy")
  createdWoSerials     WoSerial[]     @relation("WoSerialCreatedBy")
  updatedWoSerials     WoSerial[]     @relation("WoSerialUpdatedBy")
  createdSterilises    Sterilise[]    @relation("SteriliseCreatedBy")
  updatedSterilises    Sterilise[]    @relation("SteriliseUpdatedBy")
  createdPhaseEquips   PhaseEquip[]   @relation("PhaseEquipCreatedBy")
  updatedPhaseEquips   PhaseEquip[]   @relation("PhaseEquipUpdatedBy")
  startedWorkOrders    WorkOrder[]    @relation("WorkOrderStartSignBy")
  endedWorkOrders      WorkOrder[]    @relation("WorkOrderEndSignBy")
  releasedWorkOrders   WorkOrder[]    @relation("WorkOrderReleaseDecisionBy")
  signedSterilises     Sterilise[]    @relation("SteriliseSignBy")
  createdManufacturers Manufacturer[] @relation("ManufacturerCreatedBy")
  updatedManufacturers Manufacturer[] @relation("ManufacturerUpdatedBy")
  createdWorkflows     Workflow[]     @relation("WorkflowCreatedBy")
  updatedWorkflows     Workflow[]     @relation("WorkflowUpdatedBy")

  @@index([tenantId])
  @@map("staff")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  builtIn     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("rolePermission")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorId     String?
  actorEmail  String?
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([actorId])
  @@map("auditLog")
}

model Manufacturer {
  id          String   @id @default(cuid())
  tenantId    String   @default("ventas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  manuName    String?
  manuNumber  String?
  keyText     String?

  createdBy  Staff?            @relation("ManufacturerCreatedBy", fields: [createdById], references: [id])
  updatedBy  Staff?            @relation("ManufacturerUpdatedBy", fields: [updatedById], references: [id])
  workOrders WorkOrder[]
  sterilises Sterilise[]
  batchHets  ManufacturerHet[]

  @@index([tenantId])
  @@map("manufacturer")
}

// A Step is a numbered work item (e.g. "G23 · Packing for EtO") owned by one
// Phase. Steps are ordered within their phase via sortOrder. A Step with a null
// phaseId is "unplaced" — it belongs to the workflow's pool but is not yet slotted
// into a phase (the "Available to pull in" list in the configurator).
model Step {
  id          String   @id @default(cuid())
  tenantId    String   @default("ventas")
  workflowId  String
  phaseId     String?
  sortOrder   Int      @default(0)
  code        String?
  name        String?
  description String?
  keyText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  workflow  Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  phase     Phase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  createdBy Staff?   @relation("StepCreatedBy", fields: [createdById], references: [id])
  updatedBy Staff?   @relation("StepUpdatedBy", fields: [updatedById], references: [id])

  @@index([tenantId])
  @@index([workflowId])
  @@index([phaseId])
  @@map("step")
}

model Bom {
  id          String   @id
  tenantId    String   @default("ventas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  bomName     String?
  keyText     String?

  createdBy Staff?    @relation("BomCreatedBy", fields: [createdById], references: [id])
  updatedBy Staff?    @relation("BomUpdatedBy", fields: [updatedById], references: [id])
  lines     BomLine[]
  phases    Phase[]

  @@index([tenantId])
  @@map("bom")
}

model BomLine {
  id          String   @id
  tenantId    String   @default("ventas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  bomId       String
  bomName     String?
  description String?
  quantity    Decimal? @db.Decimal(18, 4)
  uom         String?
  hasSerial   Boolean  @default(false)
  deleted     Boolean  @default(false)
  keyText     String?
  inventorySkuId String?

  createdBy    Staff?        @relation("BomLineCreatedBy", fields: [createdById], references: [id])
  updatedBy    Staff?        @relation("BomLineUpdatedBy", fields: [updatedById], references: [id])
  bom          Bom           @relation(fields: [bomId], references: [id])
  inventorySku InventorySku? @relation(fields: [inventorySkuId], references: [id], onDelete: SetNull)
  woSerials    WoSerial[]
  consumptions WorkOrderInventoryConsumption[]

  @@index([tenantId])
  @@index([inventorySkuId])
  @@map("bomLine")
}

model Het {
  id                      String                 @id
  tenantId                String                 @default("ventas")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  createdById             String?
  updatedById             String?
  clinicId                String?
  HCICode                 String?
  clinicName              String?
  licenseName             String?
  address                 String?
  hetNumber               String?
  parcelTrackingNumber    String?
  deliverId               String?
  collectId               String?
  usedById                String?
  finishedById            String?
  quantity                Int?
  deleted                 Boolean                @default(false)
  forceField              Int?
  keyText                 String?
  b11Weight               Decimal?               @db.Decimal(18, 4)
  collectionUnitId        String?
  collectionReceiptLineId String?
  collectionUnit          CollectionUnit?        @relation(fields: [collectionUnitId], references: [id])
  collectionReceiptLine   CollectionReceiptLine? @relation(fields: [collectionReceiptLineId], references: [id])
  inventoryLot            InventoryLot?          @relation("HetInventoryLot")
  sourceSystem            String?
  legacyClinicId          String?
  legacyDeliverId         String?
  legacyCollectId         String?

  createdBy        Staff?            @relation("HetCreatedBy", fields: [createdById], references: [id])
  updatedBy        Staff?            @relation("HetUpdatedBy", fields: [updatedById], references: [id])
  usedBy           WorkOrder?        @relation("HetUsedBy", fields: [usedById], references: [id])
  finishedBy       WorkOrder?        @relation("HetFinishedBy", fields: [finishedById], references: [id])
  workOrders       WorkOrder[]       @relation("WorkOrderHet")
  workOrderHets    WorkOrderHet[]
  steriliseHets    SteriliseHet[]
  manufacturerHets ManufacturerHet[]

  @@index([tenantId])
  @@index([collectionUnitId])
  @@index([collectionReceiptLineId])
  @@map("het")
}

model Workflow {
  id          String   @id @default(cuid())
  tenantId    String   @default("ventas")
  name        String
  code        String
  description String?
  active      Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  Staff?          @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  updatedBy  Staff?          @relation("WorkflowUpdatedBy", fields: [updatedById], references: [id])
  phases     Phase[]
  steps      Step[]
  workOrders WorkOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("workflow")
}

// A Phase is a letter-grouped stage owned by exactly one Workflow and ordered
// within it via sortOrder. phaseShort holds the grouped step codes for the phase
// (e.g. "A3, A4, A5"). isGate marks a sterilisation/BET gate that requires a
// passing result before advancing; blocksCombine forbids running the phase on a
// combined (multi-HET) batch. These replace the hardcoded phaseOrder magic numbers.
model Phase {
  id            String   @id @default(cuid())
  tenantId      String   @default("ventas")
  workflowId    String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?
  phaseName     String?
  phaseShort    String?
  description   String?
  bomId         String?
  isGate        Boolean  @default(false)
  blocksCombine Boolean  @default(false)
  // Process lever for the phase, mirroring isGate/blocksCombine: null = a normal
  // production phase, 'COLLECTION' = a HET-collection/logistics phase where the
  // run starts with no HET and the collection process mints one (epic #186).
  processType   String?
  keyText       String?

  workflow          Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy         Staff?            @relation("PhaseCreatedBy", fields: [createdById], references: [id])
  updatedBy         Staff?            @relation("PhaseUpdatedBy", fields: [updatedById], references: [id])
  bom               Bom?              @relation(fields: [bomId], references: [id])
  steps             Step[]
  phaseEquips       PhasePhaseEquip[]
  currentWorkOrders WorkOrder[]       @relation("WorkOrderCurrentPhase")
  nextWorkOrders    WorkOrder[]       @relation("WorkOrderNextPhase")

  @@index([tenantId])
  @@index([workflowId])
  @@map("phase")
}

model PhaseEquip {
  id          String   @id
  tenantId    String   @default("ventas")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  equipId     String?
  name        String?
  description String?
  keyText     String?

  createdBy  Staff?                @relation("PhaseEquipCreatedBy", fields: [createdById], references: [id])
  updatedBy  Staff?                @relation("PhaseEquipUpdatedBy", fields: [updatedById], references: [id])
  phases     PhasePhaseEquip[]
  workOrders WorkOrderPhaseEquip[]

  @@index([tenantId])
  @@map("phaseEquip")
}

model PhasePhaseEquip {
  phaseId      String
  phaseEquipId String
  phase        Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  phaseEquip   PhaseEquip @relation(fields: [phaseEquipId], references: [id], onDelete: Cascade)

  @@id([phaseId, phaseEquipId])
  @@map("phasePhaseEquip")
}

model WorkOrder {
  id                     String    @id
  tenantId               String    @default("ventas")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdById            String?
  updatedById            String?
  hetId                  String?
  phaseId                String?
  phaseOrder             Int?
  phaseShort             String?
  prodStart              DateTime?
  startSignPath          String?
  startSignById          String?
  prodEnd                DateTime?
  endSignPath            String?
  endSignById            String?
  prodDuration           Decimal?  @db.Decimal(18, 4)
  outputQuantity         Decimal?  @db.Decimal(18, 4)
  imagePath              String?
  releaseStatus          String?
  releaseDecisionAt      DateTime?
  releaseDecisionById    String?
  releaseRemarks         String?
  manuId                 String?
  manuNumber             String?
  woNumber               String?
  reportPdfPath          String?
  deleted                Boolean   @default(false)
  forceField             Int?
  keyText                String?
  previousWoId           String?   @unique
  steralisationCurrentId String?   @unique
  collectionReceiptId    String?   @unique
  issuanceOrderId        String?   @unique
  nextPhaseId            String?
  workflowId             String?

  createdBy             Staff?                          @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  updatedBy             Staff?                          @relation("WorkOrderUpdatedBy", fields: [updatedById], references: [id])
  het                   Het?                            @relation("WorkOrderHet", fields: [hetId], references: [id])
  phase                 Phase?                          @relation("WorkOrderCurrentPhase", fields: [phaseId], references: [id])
  startSignBy           Staff?                          @relation("WorkOrderStartSignBy", fields: [startSignById], references: [id])
  endSignBy             Staff?                          @relation("WorkOrderEndSignBy", fields: [endSignById], references: [id])
  releaseDecisionBy     Staff?                          @relation("WorkOrderReleaseDecisionBy", fields: [releaseDecisionById], references: [id])
  manufacturer          Manufacturer?                   @relation(fields: [manuId], references: [id])
  previousWo            WorkOrder?                      @relation("WorkOrderPrevious", fields: [previousWoId], references: [id])
  nextWorkOrder         WorkOrder?                      @relation("WorkOrderPrevious")
  steralisationCurrent  Sterilise?                      @relation("WorkOrderSterilisationCurrent", fields: [steralisationCurrentId], references: [id])
  collectionReceipt     CollectionReceipt?              @relation("WorkOrderCollectionReceipt", fields: [collectionReceiptId], references: [id])
  issuanceOrder         IssuanceOrder?                  @relation("WorkOrderIssuanceOrder", fields: [issuanceOrderId], references: [id])
  nextPhase             Phase?                          @relation("WorkOrderNextPhase", fields: [nextPhaseId], references: [id])
  workflow              Workflow?                       @relation(fields: [workflowId], references: [id])
  woSerials             WoSerial[]
  sterilises            Sterilise[]
  batchHets             WorkOrderHet[]
  phaseEquips           WorkOrderPhaseEquip[]
  usedHets              Het[]                           @relation("HetUsedBy")
  finishedHets          Het[]                           @relation("HetFinishedBy")
  inventoryLots         InventoryLot[]
  inventoryConsumptions WorkOrderInventoryConsumption[]

  @@index([workflowId])
  @@index([tenantId])
  @@map("workOrder")
}

model WorkOrderAuditEvent {
  id            String   @id @default(cuid())
  tenantId      String
  workOrderId   String
  action        String
  actorId       String?
  source        String
  previousState Json?
  newState      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, workOrderId, createdAt])
  @@index([action])
  @@map("workOrderAuditEvent")
}

model WorkOrderHet {
  workOrderId String
  hetId       String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  het         Het       @relation(fields: [hetId], references: [id], onDelete: Cascade)

  @@id([workOrderId, hetId])
  @@map("workOrderHet")
}

model WorkOrderPhaseEquip {
  workOrderId  String
  phaseEquipId String
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  phaseEquip   PhaseEquip @relation(fields: [phaseEquipId], references: [id], onDelete: Cascade)

  @@id([workOrderId, phaseEquipId])
  @@map("workOrderPhaseEquip")
}

model WoSerial {
  id           String   @id
  tenantId     String   @default("ventas")
  createdOn    DateTime @default(now())
  createdById  String?
  updatedOn    DateTime @updatedAt
  updatedById  String?
  workOrderId  String
  bomRefId     String
  serialNumber String?
  keyText      String?

  createdBy Staff?    @relation("WoSerialCreatedBy", fields: [createdById], references: [id])
  updatedBy Staff?    @relation("WoSerialUpdatedBy", fields: [updatedById], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  bomRef    BomLine   @relation(fields: [bomRefId], references: [id])

  @@index([tenantId])
  @@map("woSerial")
}

model Sterilise {
  id            String    @id
  tenantId      String    @default("ventas")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  workOrderId   String
  manuId        String?
  direction     String?
  result        Boolean?
  betReading    Decimal?  @db.Decimal(18, 4)
  quantity      Int?
  comment       String?
  imagePath     String?
  signOn        DateTime?
  signById      String?
  signaturePath String?
  keyText       String?

  createdBy        Staff?         @relation("SteriliseCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        Staff?         @relation("SteriliseUpdatedBy", fields: [updatedById], references: [id])
  workOrder        WorkOrder      @relation(fields: [workOrderId], references: [id])
  manufacturer     Manufacturer?  @relation(fields: [manuId], references: [id])
  signBy           Staff?         @relation("SteriliseSignBy", fields: [signById], references: [id])
  batchHets        SteriliseHet[]
  currentWorkOrder WorkOrder?     @relation("WorkOrderSterilisationCurrent")

  @@index([tenantId])
  @@map("sterilise")
}

model SteriliseHet {
  steriliseId String
  hetId       String
  sterilise   Sterilise @relation(fields: [steriliseId], references: [id], onDelete: Cascade)
  het         Het       @relation(fields: [hetId], references: [id], onDelete: Cascade)

  @@id([steriliseId, hetId])
  @@map("steriliseHet")
}

model ManufacturerHet {
  manufacturerId String
  hetId          String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  het            Het          @relation(fields: [hetId], references: [id], onDelete: Cascade)

  @@id([manufacturerId, hetId])
  @@map("manufacturerHet")
}

model SupplyEntity {
  id             String   @id
  tenantId       String
  name           String?
  legalName      String?
  externalCode   String?
  sourceSystem   String?
  legacyGroupKey String?
  legacyClinicId String?
  deleted        Boolean  @default(false)
  deletedAt      DateTime?
  deletedById    String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([deleted])
  @@index([legacyClinicId])
  @@map("supplyEntity")
}

model CollectionPoint {
  id             String   @id
  tenantId       String
  supplyEntityId String
  legacyClinicId String?
  hciCode        String?
  displayName    String?
  licenseName    String?
  address        String?
  postalCode     String?
  telephone      String?
  personInCharge String?
  deleted        Boolean  @default(false)
  deletedAt      DateTime?
  deletedById    String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([deleted])
  @@index([supplyEntityId])
  @@index([legacyClinicId])
  @@map("collectionPoint")
}

model CollectionUnit {
  id                      String         @id
  tenantId                String
  supplyEntityId          String?
  collectionPointId       String?
  legacyHetId             String?
  unitNumber              String?
  parcelTrackingNumber    String?
  // Container lifecycle state. Imported values (importProcurementLegacy.ts):
  // RECEIVED_AS_HET, CONSUMED_IN_WORK_ORDER, ISSUED_TO_SUPPLIER_LEGACY,
  // RECEIVED_LEGACY, WORKORDER_REFERENCED_NO_PROCUREMENT_SOURCE. Kept as a free
  // String; existing values are not migrated. The bidirectional deliver/collect
  // lifecycle that drives this forward lands in epic #186 phase 2 (#189).
  status                  String
  legacyDeliverId         String?
  legacyCollectId         String?
  legacyUsedByWorkOrderId String?
  legacyNextHetId         String?
  sourceSystem            String?
  linkCompleteness        String?
  semanticConfidence      String?
  hiddenFromOperations    Boolean        @default(false)
  deleted                 Boolean        @default(false)
  deletedAt               DateTime?
  deletedById             String?
  createdById             String?
  updatedById             String?
  legacyRaw               Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  hets                    Het[]
  inventoryLots           InventoryLot[]

  @@index([tenantId])
  @@index([deleted])
  @@index([legacyHetId])
  @@index([collectionPointId])
  @@index([legacyUsedByWorkOrderId])
  @@index([status])
  @@map("collectionUnit")
}

model IssuanceOrder {
  id                     String    @id
  tenantId               String
  supplyEntityId         String?
  collectionPointId      String?
  issuedAt               DateTime?
  issuedBy               String?
  // Custody signature captured when the empty container is issued to the clinic
  // (deliver-empty leg, #189). issuedAt is the sign date, issuedBy the signer.
  signaturePath          String?
  legacyDeliverCollectId String?
  legacyDirection        String?
  semanticConfidence     String?
  level                  String?
  remarks                String?
  deleted                Boolean   @default(false)
  deletedAt              DateTime?
  deletedById            String?
  createdById            String?
  updatedById            String?
  legacyRaw              Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  currentWorkOrder       WorkOrder? @relation("WorkOrderIssuanceOrder")

  @@index([tenantId])
  @@index([deleted])
  @@index([collectionPointId])
  @@index([legacyDeliverCollectId])
  @@map("issuanceOrder")
}

model IssuanceOrderLine {
  id                   String   @id @default(cuid())
  tenantId             String
  issuanceOrderId      String
  collectionUnitId     String?
  itemCode             String?
  quantity             Decimal? @db.Decimal(18, 4)
  uom                  String?
  legacyHetId          String?
  legacyHetNumber      String?
  parcelTrackingNumber String?
  deleted              Boolean  @default(false)
  deletedAt            DateTime?
  deletedById          String?
  createdById          String?
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([issuanceOrderId, legacyHetId])
  @@index([tenantId])
  @@index([deleted])
  @@index([collectionUnitId])
  @@map("issuanceOrderLine")
}

model CollectionUnitFulfilment {
  id               String    @id @default(cuid())
  tenantId         String
  collectionUnitId String
  fulfilledAt      DateTime?
  fulfilledBy      String?
  source           String?
  evidencePath     String?
  remarks          String?
  inferred         Boolean   @default(false)
  deleted          Boolean   @default(false)
  deletedAt        DateTime?
  deletedById      String?
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([collectionUnitId, source])
  @@index([tenantId])
  @@index([deleted])
  @@map("collectionUnitFulfilment")
}

model CollectionOrder {
  id                            String    @id
  tenantId                      String
  supplyEntityId                String?
  collectionPointId             String?
  requestedAt                   DateTime?
  scheduledFor                  DateTime?
  requestedBy                   String?
  status                        String
  legacyCollectDeliverCollectId String?
  legacyDirection               String?
  semanticConfidence            String?
  legacyConflatedOrderReceipt   Boolean   @default(false)
  level                         String?
  remarks                       String?
  deleted                       Boolean   @default(false)
  deletedAt                     DateTime?
  deletedById                   String?
  createdById                   String?
  updatedById                   String?
  legacyRaw                     Json?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([tenantId])
  @@index([deleted])
  @@index([collectionPointId])
  @@index([legacyCollectDeliverCollectId])
  @@map("collectionOrder")
}

model CollectionReceipt {
  id                            String    @id
  tenantId                      String
  collectionOrderId             String?
  // Soft pointer to the deliver-empty IssuanceOrder this filled-container receipt
  // closes (#189 unit continuity). Scalar (no FK), mirroring collectionOrderId.
  issuanceOrderId               String?
  receivedAt                    DateTime?
  receivedBy                    String?
  signaturePath                 String?
  remarks                       String?
  legacyCollectDeliverCollectId String?
  legacyConflatedOrderReceipt   Boolean   @default(false)
  acceptanceState               String?
  deleted                       Boolean   @default(false)
  deletedAt                     DateTime?
  deletedById                   String?
  createdById                   String?
  updatedById                   String?
  legacyRaw                     Json?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  currentWorkOrder              WorkOrder? @relation("WorkOrderCollectionReceipt")

  @@index([tenantId])
  @@index([deleted])
  @@index([collectionOrderId])
  @@index([issuanceOrderId])
  @@index([legacyCollectDeliverCollectId])
  @@map("collectionReceipt")
}

model CollectionReceiptLine {
  id                  String   @id @default(cuid())
  tenantId            String
  collectionReceiptId String
  collectionUnitId    String?
  itemCode            String?
  quantity            Decimal? @db.Decimal(18, 4)
  uom                 String?
  conditionStatus     String?
  acceptanceStatus    String?
  resultingHetId      String?
  discrepancyReason   String?
  deleted             Boolean  @default(false)
  deletedAt           DateTime?
  deletedById         String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  hets                Het[]

  @@unique([collectionReceiptId, collectionUnitId])
  @@index([tenantId])
  @@index([deleted])
  @@index([collectionUnitId])
  @@index([resultingHetId])
  @@map("collectionReceiptLine")
}

model InventoryReference {
